# 生产环境配置文件
# 复制此文件为 .env.prod 并填入真实值

# ========== 数据库配置 ==========
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_very_secure_database_password_here
POSTGRES_DB=football_platform

# ========== JWT 安全配置 ==========
# ⚠️ 重要：请使用强随机字符串，至少 32 位
# 生成方法：openssl rand -hex 32
SECRET_KEY=your_very_secure_secret_key_here_please_change_this

# ========== Token 配置 ==========
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== 应用配置 ==========
ENV=prod
